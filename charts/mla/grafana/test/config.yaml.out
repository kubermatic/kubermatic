                  "id": "byName",
                  "options": "memory free"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#629e51"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "memory used"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#ea6460"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "datasource": {
            "uid": "$datasource"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [
                {
                  "options": {
                    "match": "null",
                    "result": {
                      "text": "N/A"
                    }
                  },
                  "type": "special"
                }
              ],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "#299c46",
                    "value": null
                  },
                  {
                    "color": "rgba(237, 129, 40, 0.89)",
                    "value": 80
                  },
                  {
                    "color": "#d44a3a",
                    "value": 90
                  }
                ]
              },
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 7,
            "w": 4,
            "x": 20,
            "y": 7
          },
          "id": 18,
          "links": [],
          "maxDataPoints": 100,
          "options": {
            "orientation": "horizontal",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "showThresholdLabels": false,
            "showThresholdMarkers": true
          },
          "pluginVersion": "9.3.1",
          "targets": [
            {
              "datasource": {
                "uid": "$datasource"
              },
              "expr": "max(\n  (\n    sum(\n      node_memory_MemTotal_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n    - node_memory_MemFree_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n    - node_memory_Buffers_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n    - node_memory_Cached_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n    )\n    /\n    sum(\n      node_memory_MemTotal_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n    )\n  ) * 100)",
              "format": "time_series",
              "intervalFactor": 2,
              "refId": "A"
            }
          ],
          "title": "Total Memory Usage",
          "transparent": true,
          "type": "gauge"
        },
        {
