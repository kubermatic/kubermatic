---
# Source: grafana/charts/grafana/templates/serviceaccount.yaml
apiVersion: v1
kind: ServiceAccount
automountServiceAccountToken: false
metadata:
  labels:
    helm.sh/chart: grafana-12.3.3
    app.kubernetes.io/name: grafana
    app.kubernetes.io/instance: release-name
    app.kubernetes.io/version: "13.0.1-security-01"
  name: release-name-grafana
  namespace: default

---
# Source: grafana/charts/grafana/templates/configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: release-name-grafana
  namespace: default
  labels:
    helm.sh/chart: grafana-12.3.3
    app.kubernetes.io/name: grafana
    app.kubernetes.io/instance: release-name
    app.kubernetes.io/version: "13.0.1-security-01"
data:
  
  grafana.ini: |
    [analytics]
    check_for_updates = true
    [auth.proxy]
    auto_sign_up = true
    enabled = true
    header_name = X-Forwarded-Email
    header_property = username
    [log]
    mode = console
    [metrics]
    enabled = false
    [paths]
    data = /var/lib/grafana/
    logs = /var/log/grafana
    plugins = /var/lib/grafana/plugins
    provisioning = /etc/grafana/provisioning
    [server]
    domain = ''
    [unified_storage]
    index_path = /var/lib/grafana-search/bleve
  dashboardproviders.yaml: |
    apiVersion: 1
    providers:
    - disableDeletion: false
      folder: ""
      name: default
      options:
        path: /var/lib/grafana/dashboards/default
      org_id: 1
      type: file
    - disableDeletion: false
      folder: Kubernetes
      name: kubernetes
      options:
        path: /var/lib/grafana/dashboards/kubernetes
      org_id: 1
      type: file
    - disableDeletion: false
      folder: Kubermatic
      name: kubermatic
      options:
        path: /var/lib/grafana/dashboards/kubermatic
      org_id: 1
      type: file

