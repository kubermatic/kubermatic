kind: ConfigMap
metadata:
  creationTimestamp: null
  name: grafana-dashboards-mla-kkp-kubernetes
  namespace: mla
data:
  nodes-overview.json: |-
    {
      "annotations": {
        "list": [
          {
            "builtIn": 1,
            "datasource": {
              "type": "grafana",
              "uid": "-- Grafana --"
            },
            "enable": true,
            "hide": true,
            "iconColor": "rgba(0, 211, 255, 1)",
            "name": "Annotations & Alerts",
            "target": {
              "limit": 100,
              "matchAny": false,
              "tags": [],
              "type": "dashboard"
            },
            "type": "dashboard"
          }
        ]
      },
      "editable": false,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 1,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "datasource": {
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 7,
            "w": 20,
            "x": 0,
            "y": 0
          },
          "id": 2,
          "links": [],
          "options": {
            "legend": {
              "displayMode": "list",
              "showLegend": true,
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "datasource": {
                "uid": "$datasource"
              },
              "expr": "avg by (node_name) (100 - (rate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\", node_name=~\"$nodes\"}[2m]) * 100))",
              "format": "time_series",
              "intervalFactor": 2,
              "legendFormat": "{{ node_name }}",
              "refId": "A"
            }
          ],
          "title": "Average CPU Utilization",
          "transparent": true,
          "type": "timeseries",
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "custom": {
                "axisPlacement": "auto",
                "drawStyle": "line",
                "showPoints": "never",
                "lineWidth": 1,
                "fillOpacity": 10,
                "spanNulls": false
              },
              "nullValueMode": "null",
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": []
          }
        },
        {
          "datasource": {
            "uid": "$datasource"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [
                {
                  "options": {
                    "match": "null",
                    "result": {
                      "text": "N/A"
                    }
                  },
                  "type": "special"
                }
              ],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "#299c46",
                    "value": null
                  },
                  {
                    "color": "rgba(237, 129, 40, 0.89)",
                    "value": 80
                  },
                  {
                    "color": "#d44a3a",
                    "value": 90
                  }
                ]
              },
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 7,
            "w": 4,
            "x": 20,
            "y": 0
          },
          "id": 17,
          "links": [],
          "maxDataPoints": 100,
          "options": {
            "orientation": "horizontal",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "showThresholdLabels": false,
            "showThresholdMarkers": true
          },
          "pluginVersion": "9.3.1",
          "targets": [
            {
              "datasource": {
                "uid": "$datasource"
              },
              "expr": "avg (100 - (rate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\", node_name=~\"$nodes\"}[2m]) * 100))",
              "format": "time_series",
              "intervalFactor": 2,
              "refId": "A"
            }
          ],
          "title": "Total CPU Usage",
          "transparent": true,
          "type": "gauge"
        },
        {
          "datasource": {
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 7,
            "w": 20,
            "x": 0,
            "y": 7
          },
          "id": 6,
          "links": [],
          "options": {
            "legend": {
              "displayMode": "list",
              "showLegend": true,
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          },
          "targets": [
            {
              "datasource": {
                "uid": "$datasource"
              },
              "expr": "max by (node_name) (\n  node_memory_MemTotal_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n  - node_memory_MemFree_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n  - node_memory_Buffers_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n  - node_memory_Cached_bytes{job=\"node-exporter\", node_name=~\"$nodes\"}\n)\n",
              "format": "time_series",
              "intervalFactor": 2,
              "legendFormat": "{{ node_name }}",
              "refId": "A"
            }
          ],
          "title": "Memory Used",
          "transparent": true,
          "type": "timeseries",
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0,
              "custom": {
                "axisPlacement": "auto",
                "drawStyle": "line",
                "showPoints": "never",
                "lineWidth": 1,
                "fillOpacity": 10,
                "spanNulls": false
              },
              "nullValueMode": "null",
              "color": {
                "mode": "palette-classic"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "memory buffers"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#eab839"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "memory cached"
                },
                "properties": [
                  {
