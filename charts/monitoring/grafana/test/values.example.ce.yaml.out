apiVersion: apps/v1
kind: Deployment
metadata:
  name: grafana
  labels:
    app: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app: grafana
  template:
    metadata:
      labels:
        app: grafana
      annotations:
        checksum/config: e1266aff9dc0ccb5147b78140be3ed2dd9d4e5138fc24ef99eb40009b96d9709
        cluster-autoscaler.kubernetes.io/safe-to-evict-local-volumes: grafana-datasources
    spec:
      initContainers:
      - image: 'quay.io/kubermatic/util:2.10.0'
        name: datasource-assembler
        command: [/bin/bash]
        args:
        - -c
        - |
          set -euo pipefail

          target=/etc/grafana/provisioning/datasources

          provide_datasources() {
            local index="$1"
            local base="$(realpath $2)"

            if [ ! -d "$base" ]; then
              echo "Error: directory $1 does not exist, check your Helm chart configuration and mounts!"
              exit 1
            fi

            for abs in $(find "$base" -maxdepth 1 -name '*.yaml'); do
              filename="$index-$(basename "$abs")"

              echo "Copying $abs to $filename"
              cp "$abs" "$target/$filename"
            done
          }

          mkdir -p "$target"
          rm -rf "$target/*"
          provide_datasources "$(printf "%02d" 0)" "/etc/grafana/provisioning/default-datasources"

          echo "Datasource provisioning completed successfully."
        resources: {}
        volumeMounts:
        - mountPath: /etc/grafana/provisioning/datasources
          name: grafana-datasources
          readOnly: false
        - mountPath: /etc/grafana/provisioning/default-datasources
          name: grafana-default-datasources
          readOnly: true

      containers:
      - image: 'docker.io/grafana/grafana-oss:10.4.1'
        name: grafana
        ports:
        - containerPort: 3000
          name: http
        resources:
          limits:
            cpu: 1
            memory: 256Mi
          requests:
            cpu: 10m
            memory: 96Mi
        volumeMounts:
        - mountPath: /etc/grafana
          name: grafana-config
          readOnly: true
        - mountPath: /etc/grafana/provisioning/datasources
          name: grafana-datasources
          readOnly: false
        - mountPath: /etc/grafana/provisioning/default-datasources
          name: grafana-default-datasources
          readOnly: true
        - mountPath: /etc/grafana/provisioning/dashboards
          name: grafana-dashboards
          readOnly: true
        - mountPath: /grafana-dashboard-definitions
          name: grafana-dashboard-definitions
          readOnly: true

      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
      serviceAccountName: grafana
      volumes:
      - emptyDir: {}
        name: grafana-datasources
      - name: grafana-config
        secret:
          secretName: grafana-config
      - name: grafana-default-datasources
        configMap:
          name: grafana-datasources
      - name: grafana-dashboards
        configMap:
          name: grafana-dashboards
      - name: grafana-dashboard-definitions
        configMap:
          name: grafana-dashboard-definitions
          items:
          - key: go-processes-deployments.json
            path: go/processes-deployments.json
          - key: go-processes.json
            path: go/processes.json
          - key: kubermatic-controller-manager.json
            path: kubermatic/controller-manager.json
          - key: kubermatic-controller-runtime.json
            path: kubermatic/controller-runtime.json
          - key: kubermatic-event-monitoring.json
            path: kubermatic/event-monitoring.json
          - key: kubermatic-machine-controller.json
            path: kubermatic/machine-controller.json
          - key: kubermatic-nodeport-proxy.json
            path: kubermatic/nodeport-proxy.json
          - key: kubermatic-user-clusters.json
            path: kubermatic/user-clusters.json
          - key: kubernetes-etcd-objects.json
            path: kubernetes/etcd-objects.json
          - key: kubernetes-etcd-overview.json
            path: kubernetes/etcd-overview.json
          - key: kubernetes-etcd.json
            path: kubernetes/etcd.json
          - key: kubernetes-kubelets-overview.json
            path: kubernetes/kubelets-overview.json
          - key: kubernetes-kubelets.json
            path: kubernetes/kubelets.json
          - key: kubernetes-node-namespaces.json
            path: kubernetes/node-namespaces.json
          - key: kubernetes-nodes-overview.json
            path: kubernetes/nodes-overview.json
          - key: kubernetes-nodes.json
            path: kubernetes/nodes.json
          - key: kubernetes-pods.json
            path: kubernetes/pods.json
          - key: kubernetes-resources-cluster.json
            path: kubernetes/resources-cluster.json
          - key: kubernetes-resources-namespace.json
            path: kubernetes/resources-namespace.json
          - key: kubernetes-resources-pod.json
            path: kubernetes/resources-pod.json
          - key: kubernetes-statefulset.json
            path: kubernetes/statefulset.json
          - key: kubernetes-volumes.json
            path: kubernetes/volumes.json
          - key: minio-overview.json
            path: minio/overview.json
          - key: mla-cortex-alertmanager.json
            path: mla/cortex-alertmanager.json
          - key: mla-cortex-compactor.json
            path: mla/cortex-compactor.json
          - key: mla-cortex-config.json
            path: mla/cortex-config.json
          - key: mla-cortex-object-store.json
            path: mla/cortex-object-store.json
          - key: mla-cortex-queries.json
            path: mla/cortex-queries.json
          - key: mla-cortex-reads.json
            path: mla/cortex-reads.json
          - key: mla-cortex-resources.json
            path: mla/cortex-resources.json
          - key: mla-cortex-rollout-progress.json
            path: mla/cortex-rollout-progress.json
          - key: mla-cortex-ruler.json
            path: mla/cortex-ruler.json
          - key: mla-cortex-scaling.json
            path: mla/cortex-scaling.json
          - key: mla-cortex-slow-queries.json
            path: mla/cortex-slow-queries.json
          - key: mla-cortex-writes.json
            path: mla/cortex-writes.json
          - key: mla-mla-components.json
            path: mla/mla-components.json
          - key: monitoring-blackbox-exporter.json
            path: monitoring/blackbox-exporter.json
          - key: monitoring-prometheus.json
            path: monitoring/prometheus.json
          - key: nginx-ingress-controller-overview.json
            path: nginx-ingress-controller/overview.json
      nodeSelector:
        {}
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - podAffinityTerm:
              labelSelector:
                matchLabels:
                  app: grafana
              topologyKey: kubernetes.io/hostname
            weight: 100
      tolerations:
        []
