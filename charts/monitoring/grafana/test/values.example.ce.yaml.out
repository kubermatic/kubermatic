    # See the License for the specific language governing permissions and
    # limitations under the License.
    
    apiVersion: 1
    datasources:
    
    
    
    
    
    
    - name: prometheus
      type: prometheus
      access: proxy
      org_id: 1
      url: 'http://prometheus.default.svc.cluster.local:9090'
      version: 1
      editable: false
