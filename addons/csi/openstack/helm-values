# use a dynamic cluster name
clusterID: '{{ .Cluster.Name }}'

# these are put on the Pods _and_ the Deployments
commonAnnotations:
  # add annotation to allow eviction by cluster-autoscaler
  cluster-autoscaler.kubernetes.io/safe-to-evict-local-volumes: socket-dir

secret:
  enabled: true
  name: cloud-config-csi
  filename: config # key inside the cloud-config-csi Secret

# Storage classes are not installed through this addon. They are managed using the `default-storage-class` addon.
storageClass:
  enabled: false

csi:
  # Override sidecar image tags pinned by the chart; they lag upstream releases
  # and accumulate known CVEs (see https://github.com/kubermatic/kubermatic/issues/16192).
  # The chart's csi-snapshotter default is not just stale but a regression: v8.4.0 ships
  # more CRITICAL/HIGH findings than the v8.3.0 it replaced, while v8.6.0 rebased onto
  # Debian 13 and drops most of them (measurements in kubermatic/kubeone#4193).
  # csi-provisioner and csi-resizer are intentionally not overridden: the chart already
  # ships the latest release of their respective majors (v5.x / v1.x).
  attacher:
    image:
      tag: v4.12.0
  snapshotter:
    image:
      tag: v8.6.0
  livenessprobe:
    image:
      tag: v2.19.0
  nodeDriverRegistrar:
    image:
      tag: v2.17.0
  plugin:
    volumes:
      - name: ca-bundle
        configMap:
          name: ca-bundle
    volumeMounts:
      - mountPath: /etc/kubermatic/certs
        name: ca-bundle
        readOnly: true
      - name: cloud-config
        mountPath: /etc/config
        readOnly: true
    extraEnv:
      # use KKP's CA bundle
      - name: SSL_CERT_FILE
        value: /etc/kubermatic/certs/ca-bundle.pem

    controllerPlugin:
      podSecurityContext:
        seccompProfile:
          type: RuntimeDefault

    nodePlugin:
      securityContext:
        seccompProfile:
          type: RuntimeDefault
